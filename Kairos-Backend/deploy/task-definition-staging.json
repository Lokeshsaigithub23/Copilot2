{
  "family": "task-kairos-staging-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::974780914474:role/role-copilotiq-staging-execution-app",
  "taskRoleArn": "arn:aws:iam::974780914474:role/role-copilotiq-staging-task",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "copilotiq-api-staging",
      "image": "IMAGE_PLACEHOLDER",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4100,
          "hostPort": 4100,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "4100"
        },
        {
          "name": "FIREBASE_PROJECT_ID",
          "value": "ai-communication-copilot-7f9c0"
        },
        {
          "name": "FIREBASE_CERTS_URL",
          "value": "https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com"
        },
        {
          "name": "CORS_ORIGIN",
          "value": "https://app.myinterviewcopilot.com"
        },
        {
          "name": "PUBLIC_API_BASE_URL",
          "value": "https://copilotiq-api.myinterviewcopilot.com"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:974780914474:secret:/kairos/staging/database/app-RkpDbs:url::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:974780914474:secret:/kairos/staging/auth-wjdc4Z:JWT_SECRET::"
        },
        {
          "name": "DEEPGRAM_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:974780914474:secret:/kairos/staging/provider-api-keys-25pzax:DEEPGRAM_API_KEY::"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:974780914474:secret:/kairos/staging/provider-api-keys-25pzax:OPENAI_API_KEY::"
        },
        {
          "name": "GROQ_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:974780914474:secret:/kairos/staging/provider-api-keys-25pzax:GROQ_API_KEY::"
        },
        {
          "name": "GROK_UPLOAD_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:974780914474:secret:/kairos/staging/provider-api-keys-25pzax:GROK_UPLOAD_API_KEY::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"require('http').get('http://127.0.0.1:4100/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/kairos/staging/api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
