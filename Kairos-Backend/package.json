{
  "name": "copilot-backend",
  "version": "1.0.0",
  "description": "Backend API for My Interview Copilot application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:local": "node scripts/ensure-database.js && node server.js",
    "dev": "node scripts/ensure-database.js && nodemon server.js",
    "test": "node --test test/*.test.js",
    "db:push": "node scripts/ensure-database.js",
    "db:generate": "node scripts/prisma-generate.js",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.19.3",
    "stripe": "^23.0.0",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "private": true
}
