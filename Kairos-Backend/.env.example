CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
PORT=4000
JWT_SECRET=super-secret-copilot-key-2026-xyz

# Deepgram API key for real-time speech-to-text (required for transcription)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Google Speech-to-Text API key
GOOGLE_SPEECH_KEY=your_google_speech_key

# Sarvam API key (for Indian language translation and STT fallback)
SARVAM_API_KEY=your_sarvam_api_key

# Groq / xAI API key (for fast answer & note generation)
GROQ_API_KEY=your_xai_api_key

# OpenAI API key (optional - for AI answer generation)
OPENAI_API_KEY=your_openai_api_key

# Grok key for Upload page
GROK_UPLOAD_API_KEY=your_xai_upload_api_key

# Firebase Google sign-in. No Firebase service-account key is required.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CERTS_URL=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com

# Database URL
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

SAVE_IN_S3=false
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=