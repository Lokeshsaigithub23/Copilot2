      {/* Top Up Summary & Confirmation Modal (Quota Top-ups for all users & devices) */}
      {topUpConfirmModal && (
        <div
          className={`topup-summary-backdrop ${darkMode ? 'dark-theme' : 'light-theme'}`}
          onClick={() => setTopUpConfirmModal(null)}
        >
          <div
            className={`topup-summary-modal-card ${darkMode ? 'dark-theme' : 'light-theme'}`}
            onClick={(e) => e.stopPropagation()}
          >
            <div className="summary-card-header">
              <div className="summary-title-wrap">
                <div
                  className="summary-icon-pill"
                  style={{
                    background: topUpConfirmModal.featureId === 'downloads'
                      ? 'rgba(14, 165, 233, 0.2)'
                      : topUpConfirmModal.featureId === 'copilot'
                        ? 'rgba(99, 102, 241, 0.2)'
                        : topUpConfirmModal.featureId === 'voice'
                          ? 'rgba(16, 185, 129, 0.2)'
                          : 'rgba(245, 158, 11, 0.2)',
                    color: topUpConfirmModal.featureId === 'downloads'
                      ? '#0ea5e9'
                      : topUpConfirmModal.featureId === 'copilot'
                        ? '#818cf8'
                        : topUpConfirmModal.featureId === 'voice'
                          ? '#10b981'
                          : '#f59e0b'
                  }}
                >
                  <i
                    className={
                      topUpConfirmModal.featureId === 'downloads'
                        ? 'fa-solid fa-file-arrow-down'
                        : topUpConfirmModal.featureId === 'copilot'
                          ? 'fa-solid fa-robot'
                          : topUpConfirmModal.featureId === 'voice'
                            ? 'fa-solid fa-microphone'
                            : 'fa-solid fa-file-lines'
                    }
                  ></i>
                </div>
                <div>
                  <h3 className="summary-modal-title">Top Up Summary</h3>
                  <span className="summary-modal-sub">Confirm extra capacity for {topUpConfirmModal.featureName}</span>
                </div>
              </div>
              <button
                type="button"
                className="summary-close-btn"
                onClick={() => setTopUpConfirmModal(null)}
                title="Close"
              >
                ✕
              </button>
            </div>

            <div className="summary-card-body">
              <div className="summary-item-card">
                <div className="s-row">
                  <span className="s-label">Feature</span>
                  <strong className="s-val">{topUpConfirmModal.featureName}</strong>
                </div>
                <div className="s-row">
                  <span className="s-label">Duration / Quantity</span>
                  <span className="s-val highlight">+{topUpConfirmModal.qty} {topUpConfirmModal.unit}</span>
                </div>
                <div className="s-row">
                  <span className="s-label">Credits Required</span>
                  <span className="s-val credits-color">
                    <i className="fa-solid fa-coins"></i> {topUpConfirmModal.totalCredits.toLocaleString()} Credits
                  </span>
                </div>
                <div className="s-row">
                  <span className="s-label">Equivalent Amount</span>
                  <span className="s-val amount-color">
                    {currencySymbol}{Math.round(convertFromUSD(topUpConfirmModal.totalUSD, currency)).toLocaleString()} {currency} (${topUpConfirmModal.totalUSD.toFixed(2)} USD)
                  </span>
                </div>
              </div>

              <div className="summary-payment-options-section">
                <label className="payment-options-heading">How would you like to complete this top-up?</label>

                <div className="payment-options-grid">
                  {/* Option A: Use Available Credits */}
                  <label className={`summary-choice-card ${modalPaymentChoice === 'credits' ? 'selected' : ''}`}>
                    <div className="choice-radio">
                      <input
                        type="radio"
                        name="topup_modal_choice"
                        value="credits"
                        checked={modalPaymentChoice === 'credits'}
                        onChange={() => setModalPaymentChoice('credits')}
                      />
                    </div>
                    <div className="choice-text-block">
                      <div className="choice-title-row">
                        <span className="choice-title">Use Available Credits</span>
                        <span className="instant-badge">Instant</span>
                      </div>
                      <div className="credits-ledger-box">
                        <div className="ledger-item">
                          <span>Available:</span>
                          <strong>{userAvailableCredits.toLocaleString()}</strong>
                        </div>
                        <div className="ledger-item required">
                          <span>Required:</span>
                          <strong>-{topUpConfirmModal.totalCredits.toLocaleString()}</strong>
                        </div>
                        <div className="ledger-item remaining">
                          <span>Remaining:</span>
                          <strong className={userAvailableCredits >= topUpConfirmModal.totalCredits ? 'text-green' : 'text-red'}>
                            {userAvailableCredits >= topUpConfirmModal.totalCredits
                              ? (userAvailableCredits - topUpConfirmModal.totalCredits).toLocaleString()
                              : 'Insufficient'}
                          </strong>
                        </div>
                      </div>
                      {userAvailableCredits < topUpConfirmModal.totalCredits && (
                        <span className="not-enough-hint">
                          ⚠️ You need {(topUpConfirmModal.totalCredits - userAvailableCredits).toLocaleString()} more credits. Choose Payment Method below.
                        </span>
                      )}
                    </div>
                  </label>

                  {/* Option B: Pay with Payment Method */}
                  <label className={`summary-choice-card ${modalPaymentChoice === 'payment_method' ? 'selected' : ''}`}>
                    <div className="choice-radio">
                      <input
                        type="radio"
                        name="topup_modal_choice"
                        value="payment_method"
                        checked={modalPaymentChoice === 'payment_method'}
                        onChange={() => setModalPaymentChoice('payment_method')}
                      />
                    </div>
                    <div className="choice-text-block">
                      <div className="choice-title-row">
                        <span className="choice-title">Pay using Payment Method</span>
                        <span className="gateway-badge">Card, UPI, PayPal</span>
                      </div>
                      <p className="choice-subtext">
                        Pay {currencySymbol}{Math.round(convertFromUSD(topUpConfirmModal.totalUSD, currency)).toLocaleString()} {currency} directly using Debit/Credit Card, UPI, Google Pay, PhonePe, Paytm, or Net Banking.
                      </p>
                    </div>
                  </label>
                </div>
              </div>
            </div>

            <div className="summary-card-footer">
              <button
                type="button"
                className="summary-cancel-btn"
                onClick={() => setTopUpConfirmModal(null)}
              >
                Cancel
              </button>

              {modalPaymentChoice === 'credits' ? (
                <button
                  type="button"
                  className="summary-confirm-btn"
                  onClick={handleConfirmCreditsTopUpFromModal}
                  disabled={userAvailableCredits < topUpConfirmModal.totalCredits}
                >
                  <i className="fa-solid fa-check"></i>
                  <span>Confirm Top Up with Credits</span>
                </button>
              ) : (
                <button
                  type="button"
                  className="summary-confirm-btn btn-payment-method"
                  onClick={handleProceedPaymentMethodFromModal}
                >
                  <span>Continue to Payment ({currencySymbol}{Math.round(convertFromUSD(topUpConfirmModal.totalUSD, currency)).toLocaleString()})</span>
                  <i className="fa-solid fa-arrow-right"></i>
                </button>
              )}
            </div>
          </div>
        </div>
      )}

      {/* Reusable Payment Checkout Modal (Handles both Subscription & Credit Top-ups) */}
      <PaymentCheckoutModal
        isOpen={checkoutModalOpen}
        onClose={() => setCheckoutModalOpen(false)}
        type={checkoutType}
        plan={selectedCheckoutPlan}
        billingCycle={billingCycle}
        creditTopUpAmount={creditTopUpAmount}
        targetCredits={targetCheckoutCredits}
        currency={currency}
        customTitle={customCheckoutTitle}
        onSuccessExtra={topUpSuccessCallback}
        onCurrencyChange={setCurrency}
        showToast={showToast}
        onPaymentSuccess={handlePaymentSuccess}
        darkMode={darkMode}
        token={token}
        onViewHistory={() => {
          setCheckoutModalOpen(false);
          setHistoryModalOpen(true);
        }}
      />

      {/* Subscription Plan Validity & Payment History Modal */}
      <SubscriptionHistoryModal
        isOpen={historyModalOpen}
        onClose={() => setHistoryModalOpen(false)}
        userSubscription={userSubscription}
        billingCycle={billingCycle}
        userCredits={userAvailableCredits}
        darkMode={darkMode}
        showToast={showToast}
        onUpgradeClick={() => {
          const el = document.querySelector('.plan-cards-section');
          if (el) el.scrollIntoView({ behavior: 'smooth' });
        }}
        onGoToUsage={onGoToUsage}
      />
    </div>
  );
}
