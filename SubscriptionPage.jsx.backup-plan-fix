import React, { useState, useEffect, useCallback } from 'react';
import { API_BASE } from '../../utils/api';
import './SubscriptionPage.css';
import PaymentCheckoutModal from './PaymentCheckoutModal';
import SubscriptionHistoryModal from './SubscriptionHistoryModal';
import GlobalCurrencySelector from './GlobalCurrencySelector';
import { getCurrency, convertFromUSD, convertToUSD, formatPriceWithConversion, CREDITS_PER_USD } from './currencyData';
import { getStoredCredits, setUserCredits, addTransactionRecord } from './transactionHistoryStore';
import './TopUpPlansSection.css';
import { BASE_PLANS, SUBSCRIPTION_PRICING, updateSubscriptionPricing } from './subscriptionPlansConfig';
import { getActiveUserPlanTier, setActiveUserPlanTier, getFeatureUsage, recordTopUpSuccess } from './topUpStore';
import { getDownloadStatus, getCopilotMinutesUsed, getVoiceMinutesUsed, updateDynamicPlanLimits } from '../../config/creditUsageConfig';

// Centralized base plans ($0 Free, $19 Pro, $29 Pro Plus)
const FALLBACK_PLANS = BASE_PLANS;

function formatMinutesToReadable(minutes, isTrial = false) {
  if (!minutes || minutes <= 0) return '0 mins';
  if (minutes >= 60) {
    const hrs = minutes / 60;
    return `${Number.isInteger(hrs) ? hrs : hrs.toFixed(1)} hrs / mo (${minutes.toLocaleString()} mins)`;
  }
  return `${minutes} mins ${isTrial ? 'total (trial)' : '/ mo'}`;
}

export default function SubscriptionPage({
  token,
  user,
  onBack,
  onGoToUsage,
  darkMode,
  toggleDarkMode,
  showToast
}) {
  const [plans, setPlans] = useState(FALLBACK_PLANS);
  const [userSubscription, setUserSubscription] = useState(null);
  const [billingCycle, setBillingCycle] = useState('monthly');
  const [loading, setLoading] = useState(true);

  // Global Multi-Currency State
  const [currency, setCurrency] = useState('USD');
  const currencyObj = getCurrency(currency);
  const currencySymbol = currencyObj.symbol;

  // Unified Reusable Payment Checkout Modal State
  const [checkoutModalOpen, setCheckoutModalOpen] = useState(false);
  const [checkoutType, setCheckoutType] = useState('subscription'); // 'subscription' | 'credits'
  const [selectedCheckoutPlan, setSelectedCheckoutPlan] = useState(null);
  const [creditTopUpAmount, setCreditTopUpAmount] = useState(1);
  const [targetCheckoutCredits, setTargetCheckoutCredits] = useState(50);
  const [customCheckoutTitle, setCustomCheckoutTitle] = useState('');
  const [topUpSuccessCallback, setTopUpSuccessCallback] = useState(null);
  const [userAvailableCredits, setUserAvailableCredits] = useState(getStoredCredits());
  const [historyModalOpen, setHistoryModalOpen] = useState(false);
  const [downloadStatus, setDownloadStatus] = useState(() => getDownloadStatus());
  const [featureUsage, setFeatureUsage] = useState(() => getFeatureUsage());
  const [topUpConfirmModal, setTopUpConfirmModal] = useState(null);
  const [modalPaymentChoice, setModalPaymentChoice] = useState('credits');

  // Interactive Top-Up Stepper Quantities for in-card quota adjustment
  const [topUpQuantities, setTopUpQuantities] = useState({
    downloads: 5,
    copilot: 1,
    voice: 1,
    notetaker: 1
  });

  const handleQuantityStep = (featureId, delta) => {
    setTopUpQuantities((prev) => {
      const current = prev[featureId] || 1;
      const next = Math.max(1, Math.min(100, current + delta));
      return { ...prev, [featureId]: next };
    });
  };

  const handleSetExactQuantity = (featureId, val) => {
    const num = Math.max(1, Math.min(100, Number(val) || 1));
    setTopUpQuantities((prev) => ({ ...prev, [featureId]: num }));
  };

  const fetchCreditBalance = useCallback(async () => {
    if (!token) {
      setUserAvailableCredits(getStoredCredits());
      return;
    }

    try {
      const res = await fetch(
        `${API_BASE}/api/credits/balance`,
        {
          headers: {
            Authorization: `Bearer ${token}`,
            'x-suppress-auth-redirect': 'true'
          }
        }
      );

      if (!res.ok) {
        throw new Error(`Credit balance request failed: ${res.status}`);
      }

      const data = await res.json();

      const availableCredits = Number(
        data?.credits?.availableCredits ?? 0
      );

      if (Number.isFinite(availableCredits)) {
        setUserAvailableCredits(availableCredits);
        setUserCredits(availableCredits);
      }
    } catch (err) {
      console.warn(
        '[Billing] Credit balance fetch failed, using local balance:',
        err.message
      );

      setUserAvailableCredits(getStoredCredits());
    }
  }, [token]);

  // Sync state when active user changes or mounts
  useEffect(() => {
    fetchCreditBalance();
    setFeatureUsage(getFeatureUsage());
    setDownloadStatus(getDownloadStatus());
  }, [user, fetchCreditBalance]);

  // Listen for live credit balance & usage changes from any checkout actions
  useEffect(() => {
    const handleCreditsUpdate = (e) => {
      if (typeof e.detail === 'number') {
        setUserAvailableCredits(e.detail);
      } else {
        setUserAvailableCredits(getStoredCredits());
      }
    };
    const handleUsageUpdate = () => {
      setDownloadStatus(getDownloadStatus());
    };
    const handleTopUpUpdate = () => {
      setFeatureUsage(getFeatureUsage());
      setUserAvailableCredits(getStoredCredits());
      setDownloadStatus(getDownloadStatus());
    };
    window.addEventListener('copilot-credits-updated', handleCreditsUpdate);
    window.addEventListener('copilot-usage-updated', handleUsageUpdate);
    window.addEventListener('copilot-topup-updated', handleTopUpUpdate);
    return () => {
      window.removeEventListener('copilot-credits-updated', handleCreditsUpdate);
      window.removeEventListener('copilot-usage-updated', handleUsageUpdate);
      window.removeEventListener('copilot-topup-updated', handleTopUpUpdate);
    };
  }, []);

  // Top-Up execution directly from quota cards - ALWAYS opens the Top-Up Confirmation Modal!
  const handleExecuteTopUp = (featureId, featureName, unit, creditsPerUnit = 50, priceUSDPerUnit = 1.0) => {
    const qty = topUpQuantities[featureId] || 1;
    const totalCredits = qty * creditsPerUnit;
    const totalUSD = qty * priceUSDPerUnit;
    const currentCredits = getStoredCredits();

    setModalPaymentChoice(currentCredits >= totalCredits ? 'credits' : 'payment_method');
    setTopUpConfirmModal({
      featureId,
      featureName,
      unit,
      qty,
      creditsPerUnit,
      priceUSDPerUnit,
      totalCredits,
      totalUSD,
      currentCredits
    });
  };

  const handleConfirmCreditsTopUpFromModal = () => {
    if (!topUpConfirmModal) return;
    const { featureId, featureName, unit, qty, totalCredits, totalUSD } = topUpConfirmModal;
    const currentCredits = getStoredCredits();

    if (currentCredits < totalCredits) {
      if (showToast) showToast('⚠️ Insufficient credits in wallet. Please choose payment method.');
      setModalPaymentChoice('payment_method');
      return;
    }

    const newCredits = currentCredits - totalCredits;
    setUserCredits(newCredits);

    recordTopUpSuccess({
      featureId,
      featureName,
      quantity: qty,
      unit,
      creditsRequired: totalCredits,
      amountUSD: totalUSD,
      currency: 'USD',
      currencySymbol: '$',
      paymentType: 'credits',
      paymentMethod: 'Credits Balance',
      planTier: userSubscription?.tier || userSubscription?.planId || 'FREE'
    });

    addTransactionRecord({
      type: 'Quota Top-up',
      planOrPackage: `${featureName} (+${qty} ${unit})`,
      creditsAdded: 0,
      creditsUsed: totalCredits,
      amount: 0,
      currency: 'USD',
      currencySymbol: '$',
      paymentMethod: 'Credits Balance',
      methodCode: 'credits',
      status: 'Successful',
      referenceId: `REF-TOP-${Math.floor(100000 + Math.random() * 900000)}`
    });

    // Synchronously update userSubscription so limits reflect immediately!
    setUserSubscription((prev) => {
      if (!prev) return prev;
      const updated = { ...prev };
      if (featureId === 'copilot') {
        updated.copilotLimit = (Number(prev.copilotLimit) || 30) + (qty * 60);
      } else if (featureId === 'voice') {
        updated.voiceLimit = (Number(prev.voiceLimit) || 10) + (qty * 60);
      } else if (featureId === 'notetaker') {
        updated.notetakerLimit = (Number(prev.notetakerLimit) || 30) + (qty * 60);
      }
      return updated;
    });

    setUserAvailableCredits(getStoredCredits());
    setFeatureUsage(getFeatureUsage());
    setDownloadStatus(getDownloadStatus());
    setTopUpConfirmModal(null);
    if (showToast) {
      showToast(`🎉 Successfully you added +${qty} ${unit} to your current plan!`);
    }
  };

  const handleProceedPaymentMethodFromModal = () => {
    if (!topUpConfirmModal) return;
    const { featureId, featureName, unit, qty, totalCredits, totalUSD } = topUpConfirmModal;

    setCustomCheckoutTitle(`Top Up ${featureName} (+${qty} ${unit})`);
    setTopUpSuccessCallback(() => () => {
      recordTopUpSuccess({
        featureId,
        featureName,
        quantity: qty,
        unit,
        creditsRequired: totalCredits,
        amountUSD: totalUSD,
        currency: 'USD',
        currencySymbol: '$',
        paymentType: 'credits',
        paymentMethod: 'Payment Gateway',
        planTier: userSubscription?.tier || userSubscription?.planId || 'FREE'
      });
      addTransactionRecord({
        type: 'Quota Top-up',
        planOrPackage: `${featureName} (+${qty} ${unit})`,
        creditsAdded: 0,
        creditsUsed: totalCredits,
        amount: 0,
        currency: 'USD',
        currencySymbol: '$',
        paymentMethod: 'Payment Gateway',
        methodCode: 'gateway',
        status: 'Successful',
        referenceId: `REF-TOP-${Math.floor(100000 + Math.random() * 900000)}`
      });

      setUserSubscription((prev) => {
        if (!prev) return prev;
        const updated = { ...prev };
        if (featureId === 'copilot') {
          updated.copilotLimit = (Number(prev.copilotLimit) || 30) + (qty * 60);
        } else if (featureId === 'voice') {
          updated.voiceLimit = (Number(prev.voiceLimit) || 10) + (qty * 60);
        } else if (featureId === 'notetaker') {
          updated.notetakerLimit = (Number(prev.notetakerLimit) || 30) + (qty * 60);
        }
        return updated;
      });

      setUserAvailableCredits(getStoredCredits());
      setFeatureUsage(getFeatureUsage());
      setDownloadStatus(getDownloadStatus());
      if (showToast) {
        showToast(`🎉 Successfully you added +${qty} ${unit} to your current plan!`);
      }
    });

    setTargetCheckoutCredits(totalCredits);
    setCreditTopUpAmount(Math.max(1, Math.round(totalUSD * 100) / 100));
    setCheckoutType('credits');
    setTopUpConfirmModal(null);
    setCheckoutModalOpen(true);
  };

  // Pay As You Go & Buy Credits Widget State
  const [selectedCreditPreset, setSelectedCreditPreset] = useState(10);
  const [payAsYouGoAmount, setPayAsYouGoAmount] = useState(() => (currency === 'INR' ? '835' : '10'));
  const [customCreditAmount, setCustomCreditAmount] = useState(() => (currency === 'INR' ? '835' : '10'));

  // Keep displayed amount in sync with currency switching without mutating the original base price
  useEffect(() => {
    if (selectedCreditPreset !== 'custom') {
      const converted = currency === 'USD' ? selectedCreditPreset : Math.round(convertFromUSD(selectedCreditPreset, currency));
      setPayAsYouGoAmount(String(converted));
      setCustomCreditAmount(String(converted));
    }
  }, [currency, selectedCreditPreset]);

  // Calculate credits based on amount in selected currency using live exchange rate
  const calculateCredits = useCallback((amt) => {
    const num = Number(amt) || 0;
    const amountInUSD = convertToUSD(num, currency);
    return Math.max(0, Math.round(amountInUSD * CREDITS_PER_USD));
  }, [currency]);

  const activeTotalCredits = selectedCreditPreset === 'custom'
    ? calculateCredits(customCreditAmount)
    : Math.round(selectedCreditPreset * CREDITS_PER_USD);

  const activeAmount = selectedCreditPreset === 'custom'
    ? (Number(customCreditAmount) || 0)
    : (currency === 'USD' ? selectedCreditPreset : Math.round(convertFromUSD(selectedCreditPreset, currency)));

  const handleSelectPreset = (presetUSD) => {
    setSelectedCreditPreset(presetUSD);
    if (presetUSD === 'custom') {
      const defaultCustom = currency === 'USD' ? '100' : String(Math.round(convertFromUSD(100, currency)));
      setPayAsYouGoAmount(customCreditAmount || defaultCustom);
    } else {
      const converted = currency === 'USD' ? presetUSD : Math.round(convertFromUSD(presetUSD, currency));
      setPayAsYouGoAmount(String(converted));
      setCustomCreditAmount(String(converted));
    }
  };


  const handleOpenBuyCredits = (amt) => {
    let amountUSD = 10;
    if (selectedCreditPreset !== 'custom') {
      amountUSD = selectedCreditPreset;
    } else {
      const val = Number(amt !== undefined ? amt : customCreditAmount) || 0;
      amountUSD = convertToUSD(val, currency);
    }
    setCustomCheckoutTitle('Buy Credits Checkout');
    setTopUpSuccessCallback(null);
    setTargetCheckoutCredits(null);
    setCreditTopUpAmount(Math.max(1, Math.round(amountUSD * 100) / 100));
    setCheckoutType('credits');
    setCheckoutModalOpen(true);
  };

  // Fetch live plans from Backend (Dynamic Source of Truth)
  const fetchPlans = useCallback(async () => {
    try {
      const res = await fetch(`${API_BASE}/api/plans`);
      if (res.ok) {
        const data = await res.json();
        if (data?.plans && Array.isArray(data.plans)) {
          // Synchronize external pricing and limit config with live API plans
          updateSubscriptionPricing(data.plans);
          updateDynamicPlanLimits(data.plans);

          // Merge incoming plans with standard base plans so Free, Pro, and Pro Plus are always guaranteed
          const planMap = new Map();
          FALLBACK_PLANS.forEach((p, index) => {
            planMap.set(p.id, { ...p, displayOrder: index + 1 });
          });

          data.plans.forEach(backendPlan => {
            const existing = planMap.get(backendPlan.id) || {};
            // DO NOT OVERWRITE BACKEND PRICE WITH HARDCODED SUBSCRIPTION_PRICING
            const priceMonthly = (backendPlan.priceMonthly !== undefined && backendPlan.priceMonthly !== null)
              ? Number(backendPlan.priceMonthly)
              : (existing.priceMonthly ?? 0);

            const priceAnnual = (backendPlan.priceAnnual !== undefined && backendPlan.priceAnnual !== null)
              ? Number(backendPlan.priceAnnual)
              : (backendPlan.priceYearly !== undefined && backendPlan.priceYearly !== null)
                ? Number(backendPlan.priceYearly)
                : (backendPlan.annualPrice !== undefined && backendPlan.annualPrice !== null)
                  ? Number(backendPlan.annualPrice)
                  : null;

            let dynamicFeatures = existing.features;
            if (backendPlan.customFeatures) {
              try {
                const parsed = typeof backendPlan.customFeatures === 'string'
                  ? JSON.parse(backendPlan.customFeatures)
                  : backendPlan.customFeatures;
                if (Array.isArray(parsed) && parsed.length > 0) {
                  dynamicFeatures = parsed;
                }
              } catch (_) {}
            }

            planMap.set(backendPlan.id, {
              ...existing,
              ...backendPlan,
              name: backendPlan.name || existing.name || `${backendPlan.id} Plan`,
              priceMonthly,
              priceAnnual,
              features: dynamicFeatures,
              copilotMinutes: Number(backendPlan.copilotMinutes ?? existing.copilotMinutes ?? 30),
              notetakerMinutes: Number(backendPlan.notetakerMinutes ?? existing.notetakerMinutes ?? 30),
              voiceMinutes: Number(backendPlan.voiceMinutes ?? existing.voiceMinutes ?? 10),
              uploadHours: Number(backendPlan.uploadHours ?? existing.uploadHours ?? 0),
              uploadMaxMb: Number(backendPlan.uploadMaxMb ?? existing.uploadMaxMb ?? 100),
              storageDays: Number(backendPlan.storageDays ?? existing.storageDays ?? 7),
              downloadLimit: Number(backendPlan.downloadLimit ?? backendPlan.downloadsIncluded ?? existing.downloadLimit ?? 2),
              includedCredits: Number(backendPlan.includedCredits ?? existing.includedCredits ?? 30)
            });
          });

          const merged = Array.from(planMap.values()).sort(
            (a, b) => (a.displayOrder || 0) - (b.displayOrder || 0)
          );
          setPlans(merged);
        }
      }
    } catch (err) {
      console.warn('Using fallback plans:', err.message);
    }
  }, []);

  // Fetch user limits and active plan status dynamically from API
  const fetchUserSubscription = useCallback(async () => {
    const currentStoredTier = getActiveUserPlanTier();
    const activePlanObj = BASE_PLANS.find(p => p.id === currentStoredTier) || BASE_PLANS[0];

    const fallbackSub = {
      tier: activePlanObj.id,
      planId: activePlanObj.id,
      planName: activePlanObj.name,
      copilotLimit: activePlanObj.copilotMinutes || (activePlanObj.id === 'FREE' ? 30 : 600),
      notetakerLimit: activePlanObj.notetakerMinutes || (activePlanObj.id === 'FREE' ? 30 : 900),
      voiceLimit: activePlanObj.voiceMinutes || (activePlanObj.id === 'FREE' ? 10 : 90),
      uploadMaxMbLimit: activePlanObj.uploadMaxMb || (activePlanObj.id === 'FREE' ? 100 : 500),
      storageDays: activePlanObj.storageDays || (activePlanObj.id === 'FREE' ? 7 : 60),
      copilotMinutesUsed: getCopilotMinutesUsed(),
      notetakerMinutesUsed: 0,
      voiceMinutesUsed: getVoiceMinutesUsed(),
      uploadHoursUsed: 0,
      isExpired: false,
      endDate: activePlanObj.id === 'FREE' ? null : new Date(Date.now() + 30 * 86400000).toISOString()
    };

    try {
      const headers = { 'x-suppress-auth-redirect': 'true' };
      if (token) {
        headers['Authorization'] = `Bearer ${token}`;
      }
      const res = await fetch(`${API_BASE}/api/user/subscription-limits`, { headers });
      if (res.ok) {
        const data = await res.json();
        if (data?.subscription) {
          setUserSubscription(data.subscription);
          if (data.subscription.tier) {
            setActiveUserPlanTier(data.subscription.tier);
          }
          setLoading(false);
          return;
        }
      }
    } catch (err) {
      console.warn('Subscription fetch notice:', err.message);
    }
    setUserSubscription(fallbackSub);
    setLoading(false);
  }, [token]);

  useEffect(() => {
    fetchPlans();
    fetchUserSubscription();

    const handlePlanTierSync = (e) => {
      const newTier = e.detail || getActiveUserPlanTier();
      const planObj = BASE_PLANS.find(p => p.id === newTier) || BASE_PLANS[1];
      setUserSubscription((prev) => ({
        ...prev,
        tier: planObj.id,
        planId: planObj.id,
        planName: planObj.name
      }));
    };
    window.addEventListener('copilot-plan-tier-updated', handlePlanTierSync);
    return () => window.removeEventListener('copilot-plan-tier-updated', handlePlanTierSync);
  }, [fetchPlans, fetchUserSubscription]);

  // Handle Stripe / payment gateway return URL query params (?session_id, ?payment_status, ?canceled)
  useEffect(() => {
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const sessionId = urlParams.get('session_id');
      const paymentStatus = urlParams.get('payment_status');
      const returnWindow = urlParams.get('window');

      const isCanceled =
        urlParams.get('canceled') === 'true' ||
        paymentStatus === 'cancelled' ||
        paymentStatus === 'cancel';

      const isSubscriptionReturn = returnWindow === 'subscription';

      if (isCanceled) {
        if (showToast) {
          showToast('⚠️ Payment was cancelled. No charges were made.');
        }
        const cleanUrl = window.location.pathname;
        window.history.replaceState({}, document.title, cleanUrl);
      } else if (sessionId || paymentStatus === 'success' || isSubscriptionReturn) {
        // Do NOT assume returning from Stripe means success: verify with backend
        if (showToast) {
          showToast('🔄 Checking payment and account status with server...');
        }
        Promise.all([
          fetchUserSubscription(),
          fetchCreditBalance()
        ]).then(() => {
          if (showToast) {
            showToast('âœ… Payment status and credit balance verified.');
          }
        });
        const cleanUrl = window.location.pathname;
        window.history.replaceState({}, document.title, cleanUrl);
      }
    } catch (_) {}
  }, [fetchUserSubscription, showToast]);

  const getUpgradePricing = useCallback((plan) => {
    if (!plan) return { monthlyRate: 0, totalDue: 0, periodLabel: '', billingPeriod: '/ month' };
    const baseMonthly = Number(plan.priceMonthly) || 0;
    const isYearly = billingCycle === 'yearly';

    const annualTotalUSD = (plan.priceAnnual !== undefined && plan.priceAnnual !== null)
      ? Number(plan.priceAnnual)
      : (plan.priceYearly !== undefined && plan.priceYearly !== null)
        ? Number(plan.priceYearly)
        : (plan.annualPrice !== undefined && plan.annualPrice !== null)
          ? Number(plan.annualPrice)
          : Math.round(baseMonthly * 12 * 0.8);

    const monthlyRateUSD = isYearly ? Math.round(annualTotalUSD / 12) : baseMonthly;
    const totalUSD = isYearly ? annualTotalUSD : baseMonthly;

    const convertedMonthly = convertFromUSD(monthlyRateUSD, currency);
    const convertedTotal = convertFromUSD(totalUSD, currency);
    const periodLabel = isYearly ? 'Annual Billing (Save 20%)' : 'Monthly Billing';
    const billingPeriod = isYearly ? '/ year' : '/ month';

    return {
      monthlyRate: convertedMonthly,
      totalDue: convertedTotal,
      monthlyRateUSD,
      totalUSD,
      periodLabel,
      billingPeriod
    };
  }, [billingCycle, currency]);

  const handleUpgrade = (plan) => {
    // FREE PLAN REQUIREMENT: Zero payment required, activates directly without payment modal
    const isFree =
      !plan ||
      String(plan.id || '').toUpperCase() === 'FREE' ||
      String(plan.tier || '').toUpperCase() === 'FREE' ||
      Number(plan.priceMonthly) === 0 ||
      (plan.name && plan.name.toLowerCase().includes('free'));

    if (isFree) {
      const freePlanObj = plans.find(p => p.id === 'FREE') || plan;
      setActiveUserPlanTier('FREE');
      setUserSubscription((prev) => ({
        ...prev,
        tier: 'FREE',
        planId: 'FREE',
        planName: freePlanObj?.name || 'Free Plan',
        copilotLimit: freePlanObj?.copilotMinutes || 30,
        notetakerLimit: freePlanObj?.notetakerMinutes || 30,
        voiceLimit: freePlanObj?.voiceMinutes || 10,
        uploadMaxMbLimit: freePlanObj?.uploadMaxMb || 100,
        storageDays: freePlanObj?.storageDays || 7,
        copilotMinutesUsed: 0,
        notetakerMinutesUsed: 0,
        voiceMinutesUsed: 0,
        uploadHoursUsed: 0,
        isExpired: false,
        endDate: new Date(Date.now() + 365 * 86400000).toISOString()
      }));
      setCheckoutModalOpen(false);
      setSelectedCheckoutPlan(null);
      if (token) {
        fetch(`${API_BASE}/api/user/upgrade`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-suppress-auth-redirect': 'true',
            Authorization: `Bearer ${token}`
          },
          body: JSON.stringify({ tier: 'FREE', durationDays: 365 })
        }).catch(() => {});
      }
      if (showToast) {
        showToast('🎉 Free Plan activated successfully! No payment required.');
      }
      return;
    }

    // PAID PLANS (Pro, Pro Plus): Prompt for payment / credits checkout
    setSelectedCheckoutPlan(plan);
    setCheckoutType('subscription');
    setCheckoutModalOpen(true);
  };

  const handlePaymentSuccess = async (receipt) => {
    if (receipt.type === 'subscription' && receipt.plan) {
      const targetPlan = plans.find((p) => p.id === receipt.plan.id) || receipt.plan;

      // Update local storage and reactive store immediately
      setActiveUserPlanTier(targetPlan.id);

      setUserSubscription((prev) => ({
        ...prev,
        tier: targetPlan.id,
        planId: targetPlan.id,
        planName: targetPlan.name,
        copilotLimit: targetPlan.copilotMinutes ?? (targetPlan.id === 'PRO_PLUS' ? 2400 : 600),
        notetakerLimit: targetPlan.notetakerMinutes ?? (targetPlan.id === 'PRO_PLUS' ? 3000 : 900),
        voiceLimit: targetPlan.voiceMinutes ?? (targetPlan.id === 'PRO_PLUS' ? 300 : 90),
        uploadMaxMbLimit: targetPlan.uploadMaxMb ?? (targetPlan.id === 'PRO_PLUS' ? 2048 : 500),
        storageDays: targetPlan.storageDays ?? (targetPlan.id === 'PRO_PLUS' ? -1 : 60),
        isExpired: false,
        endDate: new Date(Date.now() + (billingCycle === 'yearly' ? 365 : 30) * 86400000).toISOString()
      }));

      // Refresh backend limits and sync
      if (token) {
        try {
          await fetch(`${API_BASE}/api/user/upgrade`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'x-suppress-auth-redirect': 'true',
              Authorization: `Bearer ${token}`
            },
            body: JSON.stringify({
              tier: targetPlan.id,
              durationDays: billingCycle === 'yearly' ? 365 : 30
            })
          });
        } catch (_) {}
      }

      // Re-fetch backend subscription limits to confirm
      fetchUserSubscription();
      setUserAvailableCredits(getStoredCredits());
      setDownloadStatus(getDownloadStatus());

      if (typeof window !== 'undefined') {
        window.dispatchEvent(new CustomEvent('copilot-plan-tier-updated', { detail: targetPlan.id }));
        window.dispatchEvent(new CustomEvent('copilot-usage-updated'));
        window.dispatchEvent(new CustomEvent('copilot-transactions-updated'));
      }

      if (showToast) {
        showToast(`🎉 Success! Upgraded to ${targetPlan.name}.`);
      }
    } else if (receipt.type === 'credits') {
